# Detect text files and normalise their line endings in Git.
* text=auto

# Project source, environment, and documentation.
*.jl text
*.toml text
*.md text diff=markdown

# Shell and cluster scripts need Unix line endings.
*.sh text eol=lf
*.slurm text eol=lf

# Numerical data and figure assets.
*.jld2 binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
